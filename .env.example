# Supabase project settings
# Find these in your Supabase project: Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Session cookie signing secret. Any long random string works — generate
# your own with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Never reuse this value across projects, never commit the real value.
SESSION_SECRET=your-random-secret

# Protects /api/cron/reset-demo — Vercel's Scheduled Functions send this
# automatically as "Authorization: Bearer <value>" when set as an env var,
# so no extra Vercel config is needed beyond setting it here and in Vercel.
# Generate the same way as SESSION_SECRET, and never reuse that value here.
CRON_SECRET=your-random-secret
